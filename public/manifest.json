{
  "manifest_version": 3,
  "name": "VibeConnect",
  "version": "1.0",
  "description": "Peer-to-peer chat and audio call app as a Chrome extension.",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "VibeConnect"
  },
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
} 